# Copy to .env (or export these variables) before running.

# Optional but recommended: enables natural-language answers grounded in the knowledge base.
# Without it, Taiba AI runs in "extractive mode" and shows the matching official passages.
ANTHROPIC_API_KEY=
TAIBA_MODEL=claude-sonnet-5-5

# Required to enable the admin panel (/admin). If empty, all admin endpoints are disabled.
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Comma-separated list of allowed browser origins for CORS (leave empty for same-origin only).
CORS_ORIGINS=

# Chat rate limit per IP (requests per minute).
RATE_LIMIT_PER_MIN=30
